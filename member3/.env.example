GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Set these only after calibrating quiet-room and fan/music RMS on the demo laptop.
# Until VOICE_THRESHOLDS_CALIBRATED=true and a baseline is set, noise reports UNKNOWN.
VOICE_THRESHOLDS_CALIBRATED=false
VOICE_NOISE_BASELINE_RMS=
VOICE_NOISE_LOW_MAX_RATIO=
VOICE_NOISE_MED_MAX_RATIO=
VOICE_NOISE_ENTER_RATIO=
VOICE_NOISE_EXIT_RATIO=
VOICE_STATUS_MIN_DWELL_SECONDS=5
VOICE_ASR_FAILURE_WINDOW=5
VOICE_ASR_FAILURES_TO_UNCERTAIN=2
VOICE_CLEAN_UTTERANCES_TO_RECOVER=2
