{
  "manifest_version": 3,
  "name": "ContextSwitch — Touchless KiCanvas Controller",
  "version": "1.2.0",
  "description": "Touchless KiCanvas interaction via Computer Vision, Voice commands, and Head/Hand gestures for electronics labs.",
  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8001/*",
    "http://127.0.0.1:8000/*",
    "ws://127.0.0.1:8001/*",
    "ws://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["kicanvas.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ContextSwitch Lab Assistant"
  }
}
