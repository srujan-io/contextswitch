
{
  "manifest_version": 3,
  "name": "ContextSwitch",
  "version": "1.0.1",
  "description": "Multimodal hands-free control for KiCanvas using head gestures, finger tracking, and pinch detection.",
  "permissions": [
    "tabs",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://kicanvas.org/*",
    "https://*.kicanvas.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kicanvas.org/*",
        "https://*.kicanvas.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
